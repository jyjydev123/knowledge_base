# ===== 数据库 =====
# postgresql+asyncpg://用户名:密码@主机:端口/库名
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/knowledge_base
# 旧写法也兼容，二选一即可（留空则使用上面的默认值）
#PSQL_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/knowledge_base
# 开发时想看打印的 SQL 就设 True
SQL_ECHO=False

# 启动检查：表不齐是否拒绝启动（生产/Docker 建议 True；默认只告警，/health 如实返 503）
DB_STRICT_STARTUP=False
# 仅开发：启动时自动建表（正式环境请用迁移，别在生产的 PG 上开这个）
AUTO_CREATE_TABLES=False
# 健康检查探库的超时秒数
HEALTH_CHECK_TIMEOUT_SECONDS=2

# ===== JWT =====
# 上线前务必换成随机长字符串: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-key-please-change-me
ALGORITHM=HS256
# token 有效期（分钟），默认 1 天
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 其它 =====
# 只认 APP_DEBUG（别用裸 DEBUG，容易被 shell/node 工具污染）
APP_DEBUG=True
API_V1_PREFIX=/api/v1
# 允许调用 /api/v1/user/list 的管理员用户名，逗号分隔
ADMIN_USERNAMES=admin
# 前端地址，逗号分隔；生产环境请收敛成具体域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== LLM（对话模型）=====
# 占位值（your_xxx_here / sk-xxxx）会被当成"未配置"，记忆层自动降级成规则式，不会白跑一次网络
# 旧写法 OPENAI_API_KEY / OPENAI_API_BASE_URL 仍然兼容
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# ===== Embedding（文档向量化 + 向量检索车道 + 长期记忆的 pgvector 后端）=====
# 已拍板：阿里云百炼（DashScope）的 OpenAI 兼容模式 + text-embedding-v3。
# **只需要填 EMBEDDING_API_KEY 这一个值**，端点/模型/维度都有可用默认值。
# 它和对话模型是两家：DeepSeek 没有 embedding 接口，LLM_API_KEY 拿来这儿会直接 401。
#
# 改下面任何一个值之前先读这四条（都是不可逆或必炸的）：
#   1. EMBEDDING_DIMS 一旦建过 collection 就不能改。换维度必须连 DOCUMENT_VECTOR_COLLECTION
#      一起换名 + 全库重跑，否则插入时报维度不一致。v3 只支持 1024/768/512/256/128/64，
#      填错**启动时就直接报错**（不让进程起来，比第一次写向量才发现省事）。
#   2. 单请求最多 10 条文本（v3/v4 都是）。langchain 的 OpenAIEmbeddings 默认 chunk_size=1000，
#      所以 EMBEDDING_BATCH_SIZE 必须 <=10，否则每批 add_texts 都 400 —— 代码里已显式设好。
#   3. 兼容模式**不支持稀疏向量**，所以"混合检索"= 稠密向量 + 关键词两路合并，不是 pgvector 原生 sparse。
#   4. 计费按 token（v3 约 0.0005 元/千 token，新号一般带免费额度，以百炼控制台为准）。
#      想换 text-embedding-v4（维度多两档、额度更大）只改 EMBEDDING_MODEL 一个值。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 国际站把上面换成 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 换回 OpenAI 本体：EMBEDDING_BASE_URL=https://api.openai.com/v1 + MODEL=text-embedding-3-small + DIMS=1536
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMS=1024
EMBEDDING_BATCH_SIZE=10

# ===== 上传限制（手机端必须卡死）=====
# 客户端的限制只是体验优化，服务端才是唯一有效的闸。
# 上限是在**流式读的过程中**判的，不信 Content-Length（那玩意客户端想写多少写多少）
UPLOAD_MAX_SIZE_MB=20
# 图片车道单独一个上限（POST /documents/image/upload，status=stored 不参与解析）
IMAGE_MAX_SIZE_MB=8
# 空文件（0 字节）是否拒收。默认拒：它进库只会变成一条永远解析失败的记录
UPLOAD_REJECT_EMPTY=True

# ===== Redis 旁路缓存（只加速，不是数据源）=====
# False = 整套缓存直接关掉，行为退回纯数据库；连不上/超时也一样自动回源，绝不因此报错
# ⚠️ 机器上没跑 Redis 又忘了关这里也不会变慢：失败后自动拉闸 10 秒（熔断），到点自动重试
REDIS_ENABLED=True
# 只报传输方式给 /health（host/端口/密码都不透出去）。TLS 用 rediss://，socket 用 unix://
REDIS_URL=redis://127.0.0.1:6379/0
# 比一次数据库查询还慢的缓存不如不要，所以超时给得很短
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
REDIS_MAX_CONNECTIONS=20
# 所有键的前缀（同机跑别的应用时不会互相踩），键形如 kb:user:v1:{user_id}
CACHE_KEY_PREFIX=kb
# 用户身份缓存的存活秒数。改密/改资料/注销/禁用都会**立刻删键**，TTL 只是兜底
USER_CACHE_TTL_SECONDS=300

# ===== 文档解析入库（M2 后半）=====
# 上传成功后是否自动丢后台任务去解析切块（关掉就靠 scripts 或 reindex 接口手动触发）
DOCUMENT_INDEX_ON_UPLOAD=True

# ===== 长期记忆 =====
# pgvector = 真语义向量。**默认值，也是唯一的生产车道**（需要 PG 库 + pgvector 扩展 + EMBEDDING_API_KEY）
# off      = 完全不记（灰度，或不想让记忆进 prompt 时用）
# local    = 本地 JSONL + 词面 hash。**仅供离线自测**，不是生产选项
# ⚠️ pgvector 连不上时**不会**自动退回 local（那是两份数据两套行为，而且两边都不报错）：
#    行为是明确不记 + 一条 warning，原因写在 /health 的 memory_backend.reason 里
MEMORY_BACKEND=pgvector
MEMORY_DIR=data/memory
MEMORY_TOP_K=3
MEMORY_SCORE_THRESHOLD=0.5
MEMORY_DEDUP_THRESHOLD=0.95
MEMORY_MAX_ITEMS_PER_USER=500
MEMORY_AUTO_WRITE=True
MEMORY_EXTRACT_FACTS=True
MEMORY_PG_COLLECTION=long_term_memory
# 文档向量与记忆向量**必须分 collection**（混了会互相命中，清理文档时连带删掉记忆）
DOCUMENT_VECTOR_COLLECTION=kb_documents
VECTOR_INDEX_BATCH_SIZE=64

# ===== 短期记忆（会话上下文窗口）=====
SHORT_TERM_ENABLED=True
SHORT_TERM_MAX_TURNS=6
SHORT_TERM_TOKEN_BUDGET=2000
SHORT_TERM_SUMMARY_MAX_CHARS=400
SHORT_TERM_TTL_SECONDS=14400
SHORT_TERM_MAX_SESSIONS=512
SHORT_TERM_PERSIST=False
SHORT_TERM_USE_TIKTOKEN=False

# ===== 对话（/api/v1/aichat）=====
# 检索总开关：关掉后问答照样能跑，只是不带【参考资料】（对比"凭资料答"和"凭记忆答"时用）
CHAT_RETRIEVAL_ENABLED=True
# 进 prompt 的资料块数 / 资料总长上限 / 单块截断长度
# 上限存在的理由：一个 8k 字的块会把上下文窗口整个吃掉，模型反而看不见用户的问题
CHAT_RETRIEVAL_TOP_K=4
CHAT_RETRIEVAL_MAX_CHARS=4000
CHAT_SNIPPET_CHARS=320
# 检索车道：keyword=词面 ILIKE（不联网、必定可用）/ vector=pgvector 语义 / hybrid=两路合并去重
# 默认 keyword —— 填上 EMBEDDING_API_KEY 也**不会**悄悄改变线上问答行为，切车道是显式决定。
# 车道不可用时（没 key / DATABASE_URL 是 SQLite / 远端 401 或超时）自动退回 keyword，
# 原因写在响应的 retrieval.fallback 里，不 500 也不静默。
RETRIEVAL_LANE=keyword
# 向量召回的相似度下限（0~1，0=不过滤）。调高会漏，调低会混进不相干的资料
RETRIEVAL_MIN_SCORE=0
# SSE 心跳秒数（0=不发）。手机切后台、nginx 空闲 30~60s 就会掐连接，靠心跳续命
CHAT_STREAM_HEARTBEAT_SECONDS=15
# 首轮问答用问题前缀自动命名会话时截多少字
CHAT_AUTO_TITLE_CHARS=30
# 僵尸生成键的存活时间：上一路流被硬杀且没走到 finally 时，超过这个秒数才允许被新请求顶掉
CHAT_STALE_GENERATION_SECONDS=600
